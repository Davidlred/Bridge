<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens are encrypted with a Keystore key that never leaves the device, so they must not be backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="sharedpref" path="bridge_secure.xml" /><exclude domain="database" path="bridge-secure.db" /></cloud-backup>
    <device-transfer><exclude domain="sharedpref" path="bridge_secure.xml" /><exclude domain="database" path="bridge-secure.db" /></device-transfer>
</data-extraction-rules>