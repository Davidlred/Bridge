NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge
REDIS_URL=redis://localhost:6379
# Ed25519 private key (PKCS8 PEM, newlines as \n) for access tokens. Generate one with: npm run keygen
JWT_PRIVATE_KEY_PEM=
JWT_ISSUER=https://api.thebridge.app
APPLE_CLIENT_IDS=app.thebridge.ios,app.thebridge.web
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# Apple Services ID for Sign in with Apple on Android (web flow). Return URL: <PUBLIC_URL>/v1/auth/apple/web/callback
APPLE_SERVICES_ID=
# Public origin of this API; defaults to JWT_ISSUER
PUBLIC_URL=
REPLICATE_API_TOKEN=
# Pin the newest Claude model available on Replicate; swap without an app release
MODEL_PLANNER=anthropic/claude-4-sonnet
MODEL_COACH=anthropic/claude-4-sonnet
MODEL_FAST=anthropic/claude-4-sonnet
MODEL_IMAGE=black-forest-labs/flux-1.1-pro
REVENUECAT_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
