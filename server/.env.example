NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge
REDIS_URL=redis://localhost:6379
# Ed25519 private key (PKCS8 PEM, newlines as \n) for access tokens. Generate one with: npm run keygen
JWT_PRIVATE_KEY_PEM=
JWT_ISSUER=https://api.thebridge.app
# iOS bundle id (Sign in with Apple is iOS-only)
APPLE_CLIENT_IDS=app.thebridge.Bridge
# OAuth *web* client id from Google Cloud (Google sign-in is Android-only; the app requests ID tokens for this audience)
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# Public origin of this API (links in emails); defaults to JWT_ISSUER
PUBLIC_URL=
REPLICATE_API_TOKEN=
# Claude on Replicate (decided 2026-10-19): Opus for plans and the coach, Haiku for one-word chat moderation.
# Swap without an app release; run `npm run check-ai` after changing these.
MODEL_PLANNER=anthropic/claude-opus-4.7
MODEL_COACH=anthropic/claude-opus-4.7
MODEL_FAST=anthropic/claude-4.5-haiku
MODEL_IMAGE=black-forest-labs/flux-1.1-pro
# Edits the user photo (keeps their face) for the Future Self and Reality Check images
MODEL_IMAGE_EDIT=black-forest-labs/flux-kontext-pro
# Object storage (S3 API). Leave S3_BUCKET empty in development to store files under STORAGE_DIR.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_DIR=.data/media
MEDIA_SIGNING_SECRET=
# Wraps per-user journal keys. 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JOURNAL_KEK=
# Push: Firebase service account JSON (one line) for Android; APNs auth key (.p8, newlines as \n) for iOS
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.thebridge.Bridge
# Invite links: Android signing cert SHA-256 fingerprints (comma separated) and the App Store id
ANDROID_CERT_SHA256=
APP_STORE_ID=
# Email (password reset, confirm email): Resend API key and a sender on a verified domain
RESEND_API_KEY=
MAIL_FROM=The Bridge <hello@thebridge.app>
REVENUECAT_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
